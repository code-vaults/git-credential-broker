# A user service for the host-side opener, which creates pull requests as the person running it.
#
#   install:  cp examples/host-opener.service ~/.config/systemd/user/
#             systemctl --user daemon-reload
#             systemctl --user enable --now host-opener
#   logs:     journalctl --user -u host-opener -f
#
# Adjust ExecStart to the checkout the container also sees. `%h` is this user's home, so the roots
# cover every repository below it, including ones created later.
#
# On a system without user services (a Synology NAS, for instance), the equivalent is a boot-time
# scheduled task running the same command — the point is that it is started once and stays up.
[Unit]
Description=Fulfil container requests to open pull requests, as this user
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env node /volume1/homes/JounQin/Workspaces/git-credential-broker/src/cli/helper.ts host-opener --root %h
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
