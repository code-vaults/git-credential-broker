# A user service for the host broker, which creates and replies as the person running it.
#
#   install:  npm i -g gcb-host      # the CLI is assumed to be on PATH
#             install -d -m 700 ~/.gcb-host/channel   # shared no-checkout channel
#             cp examples/gcb-host.service ~/.config/systemd/user/
#             systemctl --user daemon-reload
#             systemctl --user enable --now gcb-host
#   logs:     journalctl --user -u gcb-host -f
#
# `%h` is this user's home, so every checkout below it is served, including ones created later.
# Name a tree instead — `--root /volume1/homes/<you>` — if the container sees one outside it, and
# `--command /usr/local/bin/gh` if gh is not on the service PATH.
#
# On a system without user services (a Synology NAS, for instance), the equivalent is a boot-time
# task running the same command — see examples/gcb-host-boot.sh.
[Unit]
Description=Fulfil typed host broker requests, as this user
After=network-online.target

[Service]
# A systemd unit inherits nothing from your shell, and gh (Go) honours these while it runs. Put
# http_proxy / https_proxy / no_proxy in this file if this host needs a proxy to reach github.com.
EnvironmentFile=-/etc/git-cred-broker/proxy.env
Type=simple
# For `repo fork`, review replies or an explicit --repo, add --config <broker.config.yml> so the host broker checks its allowlist.
ExecStart=/usr/bin/env gcb host --root %h
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
