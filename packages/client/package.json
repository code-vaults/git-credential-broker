{
  "name": "gcb-client",
  "version": "0.0.4",
  "description": "Container-side gcb client: credential helper, setup, and socket-backed commands.",
  "license": "MIT",
  "author": "JounQin <admin@1stg.me>",
  "homepage": "https://github.com/code-vaults/git-credential-broker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-vaults/git-credential-broker.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gcb": "./bin/gcb.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "dependencies": {
    "gcb-core": "0.0.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "clean-pkg-json"
  }
}
